{
  "$comment": [
    "Which changed paths a RockWeb artifact can absorb without being rebuilt,",
    "and which build layer owns each compiled path for partial-layer GCS reuse.",
    "Read by Get-ArtifactPlan.ps1 (should this run repackage, partial-build, or",
    "full-build?) and by New-RepackagedArtifact.ps1 (patch a base artifact).",
    "",
    "Rules are tried in order and the first match wins. A path no rule matches is",
    "build-class (layer: all): an unknown path costs a full build, never a wrong",
    "reuse. Matching is case-insensitive because IIS is.",
    "",
    "build   the build writes or rewrites this path, or compiles from it. Optional",
    "        layer names which build shard owns it (dotnet, js-obsidian, js-blocks,",
    "        js-misc, or all). Omitted layer means all.",
    "patch   copied into the artifact verbatim by the build, so the checkout's copy",
    "        is exactly what a build would have shipped.",
    "ignore  never reaches the artifact at all.",
    "",
    "{GeneratedTheme} expands to every directory under Rock.Frontend.Styles/src/themes,",
    "read from the tree at run time rather than listed here.",
    "",
    "serverOwned mirrors the lists at the top of",
    "Deployment/PrTestEnvironments/Deploy-RockEnvironment.ps1. A change there still",
    "patches into the artifact, but a deploy keeps the server's copy, so the plan warns.",
    "Tests/PrTestEnvironments/Pester/ArtifactPlan.Tests.ps1 checks both lists against",
    "the build configs and the deploy script."
  ],
  "rules": [
    { "class": "build", "layer": "dotnet", "pattern": "RockWeb/Bin/**", "reason": "MSBuild output, plugin assemblies and resolved .refresh pointers" },
    { "class": "build", "layer": "dotnet", "pattern": "RockWeb/packages.config", "reason": "restored into RockWeb/Bin by the NuGet step" },
    { "class": "build", "layer": "dotnet", "pattern": "RockWeb/Plugins/**", "reason": "plugin projects are compiled into RockWeb/Bin" },
    { "class": "build", "layer": "js-blocks", "pattern": "RockWeb/Obsidian/Blocks/**", "reason": "Rock.JavaScript.Obsidian.Blocks output" },
    { "class": "build", "layer": "js-obsidian", "pattern": "RockWeb/Obsidian/**", "reason": "Rock.JavaScript.Obsidian output" },
    { "class": "build", "layer": "js-misc", "pattern": "RockWeb/Styles/styles-v2/**", "reason": "Rock.Frontend.Styles compiles src/styles here" },
    { "class": "build", "layer": "js-misc", "pattern": "RockWeb/Themes/{GeneratedTheme}/**", "reason": "Rock.Frontend.Styles compiles src/themes here" },
    { "class": "build", "layer": "js-misc", "pattern": "RockWeb/Scripts/Rock/Monaco/**", "reason": "Rock.JavaScript webpack.config.monaco.js output" },
    { "class": "build", "layer": "js-misc", "pattern": "RockWeb/Scripts/Rock/UI/structuredcontenteditor/**", "reason": "Rock.JavaScript.EditorJs webpack output" },
    { "class": "build", "layer": "js-misc", "pattern": "RockWeb/Scripts/Rock/realtime.js*", "reason": "Rock.JavaScript webpack.config.js output" },
    { "class": "build", "layer": "js-misc", "pattern": "RockWeb/Scripts/Rock/plyr.js*", "reason": "Rock.JavaScript webpack.config.js output" },
    { "class": "build", "layer": "js-misc", "pattern": "RockWeb/Scripts/Rock/streamchat.js*", "reason": "Rock.JavaScript webpack.config.js output" },
    { "class": "build", "layer": "all", "pattern": "RockWeb/tsconfig.json", "reason": "the build deletes it from the artifact; a patch would put it back" },
    { "class": "build", "layer": "all", "pattern": ".github/workflows/pr-test-artifact.yml", "reason": "the build recipe itself" },
    { "class": "build", "layer": "all", "pattern": ".github/scripts/artifact-paths.json", "reason": "these rules; a base judged by older rules is not trusted" },
    { "class": "build", "layer": "all", "pattern": ".github/scripts/ArtifactPaths.psm1", "reason": "applies these rules; a base judged by an older copy is not trusted" },
    { "class": "build", "layer": "all", "pattern": ".github/scripts/Get-ArtifactPlan.ps1", "reason": "decides whether to build" },
    { "class": "build", "layer": "all", "pattern": ".github/scripts/New-RepackagedArtifact.ps1", "reason": "the patch recipe" },
    { "class": "build", "layer": "all", "pattern": ".github/scripts/ArtifactRecord.psm1", "reason": "names, finds and records every artifact; a base found by an older copy is not trusted" },
    { "class": "build", "layer": "all", "pattern": ".github/scripts/New-PackagedArtifact.ps1", "reason": "how the build zips RockWeb; a base zipped another way is not what a build would make now" },
    { "class": "build", "layer": "all", "pattern": ".github/scripts/Invoke-RockDotNetBuild.ps1", "reason": "compiles the .NET layer" },
    { "class": "build", "layer": "all", "pattern": ".github/scripts/Invoke-RockJsBuild.ps1", "reason": "compiles the JS/CSS layers" },
    { "class": "build", "layer": "all", "pattern": ".github/scripts/Test-RockWebArtifact.ps1", "reason": "verifies the assembled artifact" },
    { "class": "build", "layer": "all", "pattern": ".github/scripts/Restore-ReusableArtifactLayer.ps1", "reason": "extracts reused compiled layers from a base zip" },
    { "class": "patch", "pattern": "RockWeb/**", "reason": "a Web Site project: Lava, markup, .ascx.cs and assets ship as source" },
    { "class": "ignore", "pattern": "Documentation/**", "reason": "never packaged" },
    { "class": "ignore", "pattern": "**/*.md", "reason": "never packaged" },
    { "class": "ignore", "pattern": "Tests/**", "reason": "never packaged" },
    { "class": "ignore", "pattern": "Deployment/**", "reason": "reaches the VM through the bootstrap, not the artifact" },
    { "class": "ignore", "pattern": ".github/**", "reason": "pipeline wiring, not site content" },
    { "class": "build", "layer": "js-blocks", "pattern": "Rock.JavaScript.Obsidian.Blocks/**", "reason": "compiles RockWeb/Obsidian/Blocks" },
    { "class": "build", "layer": "js-obsidian", "pattern": "Rock.JavaScript.Obsidian/**", "reason": "compiles RockWeb/Obsidian framework and controls" },
    { "class": "build", "layer": "js-misc", "pattern": "Rock.JavaScript/**", "reason": "compiles RockWeb/Scripts/Rock bundles and Monaco" },
    { "class": "build", "layer": "js-misc", "pattern": "Rock.JavaScript.EditorJs/**", "reason": "compiles structuredcontenteditor bundles" },
    { "class": "build", "layer": "js-misc", "pattern": "Rock.Frontend.Styles/**", "reason": "compiles styles-v2 and NextGen themes" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock/**", "reason": "core Rock.dll source" },
    { "class": "build", "layer": "dotnet", "pattern": "DotLiquid/**", "reason": "DotLiquid.dll source" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.AI.*/**", "reason": "Rock.AI.* assemblies" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.Blocks/**", "reason": "Rock.Blocks.dll source" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.Checkr/**", "reason": "Rock.Checkr.dll source" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.Common/**", "reason": "Rock.Common.dll source" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.Common.Web/**", "reason": "Rock.Common.Web.dll source" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.DownhillCss/**", "reason": "Rock.DownhillCss.dll source" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.Enums/**", "reason": "Rock.Enums.dll source" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.Lava/**", "reason": "Rock.Lava.dll source" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.Lava.*/**", "reason": "Rock.Lava.* assemblies" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.Mailgun/**", "reason": "Rock.Mailgun.dll source" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.Migrations/**", "reason": "Rock.Migrations.dll source" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.NCOA/**", "reason": "Rock.NCOA.dll source" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.NMI/**", "reason": "Rock.NMI.dll source" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.Oidc/**", "reason": "Rock.Oidc.dll source" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.PayFlowPro/**", "reason": "Rock.PayFlowPro.dll source" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.Rest/**", "reason": "Rock.Rest.dll source" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.Security.*/**", "reason": "Rock.Security.* assemblies" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.SendGrid/**", "reason": "Rock.SendGrid.dll source" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.Slingshot/**", "reason": "Rock.Slingshot.dll source" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.Slingshot.Model/**", "reason": "Rock.Slingshot.Model.dll source" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.StatementGenerator/**", "reason": "Rock.StatementGenerator.dll source" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.Update/**", "reason": "Rock.Update.dll source" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.Version/**", "reason": "Rock.Version.dll source" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.ViewModels/**", "reason": "Rock.ViewModels.dll source" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.WebStartup/**", "reason": "Rock.WebStartup.dll source" },
    { "class": "build", "layer": "dotnet", "pattern": "Directory.Build.*", "reason": "shared MSBuild configuration" },
    { "class": "build", "layer": "dotnet", "pattern": "NuGet.config", "reason": "NuGet package sources" },
    { "class": "build", "layer": "dotnet", "pattern": "Rock.sln", "reason": "solution structure" }
  ],
  "serverOwned": [
    { "pattern": "RockWeb/Themes/*/Styles/_variable-overrides.less", "reason": "$ServerOwnedThemeFiles: Admin Tools > Themes writes it on the box" },
    { "pattern": "RockWeb/Themes/*/Styles/_css-overrides.less", "reason": "$ServerOwnedThemeFiles: Admin Tools > Themes writes it on the box" },
    { "pattern": "RockWeb/Assets/Fonts/FontAwesome/**", "reason": "$ServerOwnedDirectories: the licensed Pro fonts live only on the box" },
    { "pattern": "RockWeb/Content/**", "reason": "$PreservedDirectories" },
    { "pattern": "RockWeb/App_Data/**", "reason": "$PreservedDirectories" },
    { "pattern": "RockWeb/Logs/**", "reason": "$PreservedDirectories" },
    { "pattern": "RockWeb/Uploads/**", "reason": "$PreservedDirectories" },
    { "pattern": "RockWeb/web.ConnectionStrings.config", "reason": "$PreservedFiles" }
  ]
}
